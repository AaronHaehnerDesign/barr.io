{
  "name": "SavedComparison",
  "type": "object",
  "properties": {
    "area_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "area_type": {
      "type": "string",
      "enum": [
        "district",
        "barri"
      ]
    },
    "label": {
      "type": "string"
    }
  },
  "required": [
    "area_ids"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}