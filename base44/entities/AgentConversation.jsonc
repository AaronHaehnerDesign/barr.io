{
  "name": "AgentConversation",
  "type": "object",
  "properties": {
    "audience": {
      "type": "string",
      "enum": [
        "b2c",
        "b2b"
      ],
      "default": "b2c",
      "description": "Which mode this conversation belongs to, so Personal and Business keep independent chat threads."
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "ongoing",
        "profile_ready",
        "completed"
      ],
      "default": "ongoing"
    },
    "draft_profile": {
      "type": "object"
    }
  },
  "required": [
    "messages"
  ]
}